# =====================================================================
# ecommerce-sales-agent — Environment configuration template
#
# Copy this file to `.env` and fill in real values locally.
# NEVER commit a real `.env` file. Do not put real secrets in this file.
# All values below are placeholders only — no actual credentials exist here.
# =====================================================================

# ---------- General app settings ----------
# Environment: local | development | staging | production
APP_ENV=local
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ---------- Database (PostgreSQL / Neon) ----------
# Connection string for the PostgreSQL database (e.g., Neon serverless Postgres).
# Use the Neon *pooled* connection string in deployment. Local placeholder below.
# SQLAlchemy driver: postgresql+psycopg://...
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE_NAME

# Connection pool tuning (Neon/serverless defaults; DB_USE_NULL_POOL=true is
# the safe choice for serverless/short-lived connections)
DB_ECHO=false
DB_USE_NULL_POOL=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT=10

# ---------- LLM providers (not wired yet — config prepared only) ----------
# Google Gemini (primary LLM)
GEMINI_API_KEY=your-gemini-api-key-here
# Exact model pin — never "latest" (see architecture audit §F)
GEMINI_MODEL=models/gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_RETRIES=2

# Fallback LLM: Nemotron via NVIDIA's OpenAI-compatible endpoint
FALLBACK_LLM_API_KEY=your-fallback-llm-api-key-here
FALLBACK_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
FALLBACK_LLM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
FALLBACK_LLM_TIMEOUT_SECONDS=20
FALLBACK_LLM_MAX_RETRIES=2

# ---------- Inventra (read-only HTTP integration) ----------
# Base URL of the Inventra API (scheme://host[:port]; no trailing /api).
INVENTRA_BASE_URL=
# Pre-issued Inventra JWT (user token). Inventra currently has NO
# service-to-service auth — this is a stopgap until it does. Leave empty locally.
INVENTRA_BEARER_TOKEN=
# Per-request timeout and bounded retry policy for transient failures.
INVENTRA_TIMEOUT_SECONDS=3
INVENTRA_MAX_RETRIES=2
INVENTRA_RETRY_BACKOFF_SECONDS=0.25

# ---------- Cache (Redis) ----------
# Redis connection URL used for caching (not wired to any feature yet)
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5

# ---------- Shopify (integration NOT implemented yet) ----------
SHOPIFY_SHOP_URL=your-shop.myshopify.com
SHOPIFY_API_VERSION=2024-10
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# ---------- Telegram (integration NOT implemented yet) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ---------- Admin dashboard (single admin, env-configured) ----------
# Login username for POST /api/v1/admin/login.
ADMIN_USERNAME=admin
# Hash of the admin password — NEVER the plaintext password.
# Generate with (from backend/):
#   python -m app.api.admin_deps
ADMIN_PASSWORD_HASH=
# Secret used to sign admin JWTs (any long random string).
JWT_SECRET_KEY=
# Access-token lifetime in minutes.
ADMIN_JWT_EXPIRE_MINUTES=480
