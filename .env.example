# =====================================================================
# ecommerce-sales-agent — Environment configuration template
#
# Copy this file to `.env` and fill in real values locally.
# NEVER commit a real `.env` file. Do not put real secrets in this file.
# All values below are placeholders only — no actual credentials exist here.
# =====================================================================

# ---------- Database (PostgreSQL / Neon) ----------
# Connection string for the PostgreSQL database (e.g., Neon serverless Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME

# ---------- LLM providers ----------
# Google Gemini API key (primary LLM)
GEMINI_API_KEY=your-gemini-api-key-here

# Fallback LLM provider key (used when the primary LLM is unavailable)
FALLBACK_LLM_API_KEY=your-fallback-llm-api-key-here
# Fallback LLM provider base URL / model, if needed
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_MODEL=

# ---------- Cache (Redis) ----------
# Redis connection URL used for caching
REDIS_URL=redis://localhost:6379/0

# ---------- Shopify ----------
# Credentials for the Shopify integration
SHOPIFY_SHOP_URL=
SHOPIFY_API_VERSION=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# ---------- Telegram ----------
# Bot token from @BotFather for the Telegram sales agent interface
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ---------- General app settings ----------
# Environment: local | development | production
APP_ENV=local
LOG_LEVEL=INFO
